# Required in standalone mode. Use a two-letter ISO 3166-1 country code.
ENERGY_SECURITY_COUNTRY=HU

# Assessment cadence. Valid range: 10-180 minutes.
ENERGY_SECURITY_REFRESH_MINUTES=30

# Weather needs both latitude and longitude. Change these example values for your deployment.
ENERGY_SECURITY_ENABLE_WEATHER=true
ENERGY_SECURITY_LATITUDE=47.4979
ENERGY_SECURITY_LONGITUDE=19.0402
ENERGY_SECURITY_TIMEZONE=Europe/Budapest
ENERGY_SECURITY_LOCATION_NAME=Budapest

# Optional provider credentials. Leave blank to use keyless providers/fallbacks where supported.
ENERGY_SECURITY_AGSI_KEY=
ENERGY_SECURITY_ENTSOE_TOKEN=

# Host port used only by compose.yaml.
ENERGY_SECURITY_PORT=8099
